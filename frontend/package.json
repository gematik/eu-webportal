{
  "name": "eu-webportal",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "ngc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"tools/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"tools/**/*.mjs\"",
    "ng": "ng",
    "ism:generate": "node tools/ism/generate-ism.mjs --profile public",
    "ism:generate:internal": "node tools/ism/generate-ism.mjs --profile internal --diagnostics",
    "test:ism": "node --test \"tools/ism/*.test.mjs\"",
    "prestart": "npm run ism:generate",
    "start": "ng serve",
    "start:internal": "npm run ism:generate:internal && ng serve --configuration internal",
    "prebuild": "npm run ism:generate",
    "build": "ng build",
    "build:internal": "npm run ism:generate:internal && ng build --configuration internal",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "//": "The application does not use Zod directly. Override transitive Zod because Angular CLI pins vulnerable 4.6.5. Version 4.6.6 fixes CVE-2023-54404. Remove when Angular resolves a fixed version.",
  "overrides": {
    "zod": "4.6.6"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "lit": "^3.3.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@xmldom/xmldom": "^0.9.12",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
